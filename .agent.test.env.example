# Copy this file to ./.agent.test.env and fill in real values.
# Load env vars only for each command, e.g.:
# sh -c '. ./.agent.test.env; terraform test -filter=tests/<feature>.tftest.hcl'

# Terraform Cloud organization context
export TFE_ORGANIZATION=""
export TFE_TOKEN=""
export TF_VAR_tfc_organization_name=""

# Project name prefix used by tests (test runs may append run IDs in CI)
export TF_VAR_tfc_project_name="station-tests"

# Azure tenant/subscription context
export TF_VAR_tenant_id=""
export TF_VAR_subscription_id=""
export ARM_SUBSCRIPTION_ID=""
